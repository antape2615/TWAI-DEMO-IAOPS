# Application
APP_NAME=IAOPS Platform
APP_VERSION=1.0.0
DEBUG=True
API_V1_PREFIX=/api/v1

# Database
DATABASE_URL=postgresql+asyncpg://iaops:iaops@postgres:5432/iaops

# Security
SECRET_KEY=iaops-secret-key-change-in-production-12345678
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# CORS
BACKEND_CORS_ORIGINS=["http://localhost:3000","http://localhost:8000"]

# AWS Configuration (opcional - dejar vacío si no tienes)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1

# Azure Configuration (opcional - dejar vacío si no tienes)
AZURE_CLIENT_ID=
AZURE_CLIENT_SECRET=
AZURE_TENANT_ID=
AZURE_SUBSCRIPTION_ID=

# GCP Configuration (opcional - dejar vacío si no tienes)
GCP_PROJECT_ID=
GCP_CREDENTIALS_PATH=

# GitHub Configuration (opcional - dejar vacío si no tienes)
GITHUB_TOKEN=
GITHUB_APP_ID=
GITHUB_APP_PRIVATE_KEY=

# GitLab Configuration (opcional - dejar vacío si no tienes)
GITLAB_TOKEN=
GITLAB_URL=https://gitlab.com

# Bitbucket Configuration (opcional - dejar vacío si no tienes)
BITBUCKET_USERNAME=
BITBUCKET_APP_PASSWORD=

# OpenAI Configuration (opcional - dejar vacío si no tienes)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4-turbo-preview

# Anthropic Configuration (opcional - dejar vacío si no tienes)
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-3-opus-20240229

# Redis
REDIS_URL=redis://redis:6379/0

# Celery
CELERY_BROKER_URL=redis://redis:6379/1
CELERY_RESULT_BACKEND=redis://redis:6379/2
